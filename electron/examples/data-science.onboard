schema_version: 2
name: "Data Science"
description: "Python-focused setup for data analysis and machine learning"

brew:
  - git
  - gh
  - python
  - pkg: pipx
    desc: Install Python CLI tools in isolated environments.
    install: brew install pipx && pipx ensurepath

cask:
  - cursor
  - pkg: docker
    name: Docker Desktop
    icon_img: https://www.docker.com/wp-content/uploads/2022/03/Moby-logo.png
    icon_bg: "#2496ED"
    desc: Run containers for reproducible environments.
    check: ls /Applications/Docker.app || brew list --cask --versions docker >/dev/null 2>&1
  - pkg: postico
    name: Postico
    icon_img: https://eggerapps.at/postico2/images/icon-rounded-256.png
    icon_bg: "#336791"
    desc: PostgreSQL client for exploring databases.
    check: ls /Applications/Postico\ 2.app || ls /Applications/Postico.app || brew list --cask --versions postico >/dev/null 2>&1
