{
  "name": "onboard-computer",
  "productName": "onboard.computer",
  "version": "0.2.0",
  "description": "Developer onboarding — get your machine ready to build.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test",
    "build": "electron-builder --mac",
    "build:dmg": "electron-builder --mac dmg",
    "package": "electron-builder --mac --publish never"
  },
  "author": "Field Theory",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.3.9",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "computer.onboard.app",
    "productName": "onboard.computer",
    "afterSign": "scripts/notarize.js",
    "protocols": [
      {
        "name": "Onboard Deep Link",
        "schemes": ["onboard"]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "afar1",
      "repo": "onboard-releases"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "minimumSystemVersion": "13.0"
    },
    "dmg": {
      "title": "onboard.computer",
      "icon": "assets/icon.icns"
    },
    "fileAssociations": [
      {
        "ext": "onboard",
        "name": "Onboard Configuration",
        "role": "Editor",
        "icon": "assets/document.icns"
      }
    ],
    "files": [
      "**/*",
      "!examples/**",
      "!*.test.js"
    ],
    "extraResources": [
      {
        "from": "examples/builder.onboard",
        "to": "builder.onboard"
      }
    ]
  }
}
