schema_version: 2
name: "Web Developer"
description: "Minimal setup for frontend and full-stack web development"

brew: [git, gh, node]

cask: [rectangle, visual-studio-code]

# Figma isn't in a known-name map, so it's spelled out in long form here to
# show both styles still work side by side.
apps:
  - id: figma
    name: Figma
    icon_img: https://static.figma.com/app/icon/1/icon-192.png
    icon_bg: "#F24E1E"
    desc: Design and prototyping tool.
    check: ls /Applications/Figma.app
    install: brew install --cask figma
    depends_on: homebrew
