schema_version: 2
name: "Builder Basics"
description: "Everything you need to start building"

brew: [git, gh, node, python, codex]

cask: [claude-code, cursor, alfred, caffeine, rectangle]

setup:
  - github
  - git-identity
  - claude
  - codex-auth
  - id: fieldtheory
    name: Field Theory
    desc: "Local voice transcripts and context management. Download the app and drag it to Applications."
    url: https://fieldtheory.com
    icon_img: fieldtheory-icon.png
    icon_bg: "#1a1a2e"
    check: ls "/Applications/Field Theory.app"
